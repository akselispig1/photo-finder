{
  "name": "photo-finder",
  "version": "1.0.0",
  "description": "AI photo memory app — find photos in natural language, learn who you are, and surface memories with friends.",
  "type": "module",
  "main": "server.js",
  "scripts": {
    "start": "node --env-file-if-exists=.env server.js",
    "dev": "node --env-file-if-exists=.env --watch server.js",
    "share": "cloudflared tunnel --url http://localhost:${PORT:-3000}"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/akselispig1/photo-finder.git"
  },
  "license": "MIT",
  "dependencies": {
    "@anthropic-ai/sdk": "^0.111.0",
    "exifr": "^7.1.3",
    "express": "^5.2.1",
    "multer": "^2.2.0"
  }
}
